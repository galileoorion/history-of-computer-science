---
import { getCollection, render } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE } from '../consts';
import { sitePath } from '../sitePath';
export async function getStaticPaths() {
  return (await getCollection('blog', ({ data }) => !data.draft)).map(post => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const sections = headings.filter(h => h.depth === 2);
const minutes = Math.max(1, Math.ceil((post.body ?? '').trim().split(/\s+/).length / 220));
---
<!doctype html>
<html lang="en">
  <head><BaseHead title={`${post.data.title} — ${SITE_TITLE}`} description={post.data.description} type="article" author={post.data.author} pubDate={post.data.pubDate} updatedDate={post.data.updatedDate} category={post.data.category} tags={post.data.tags} image={post.data.heroImage} /></head>
  <body>
    <Header />
    <main id="main-content" class="article-frame frame">
      <header class="article-header">
        <a class="back-link" href={sitePath()}>← All posts</a>
        <p class="eyebrow">Post {String(post.data.sequence).padStart(2, '0')} <span class="meta-divider">/</span> {post.data.category}</p>
        <h1>{post.data.title}</h1>
        {post.data.subtitle && <p class="article-subtitle">{post.data.subtitle}</p>}
        <div class="article-meta"><span>By {post.data.author}</span><span>{minutes} min read</span>{post.data.pubDate && <FormattedDate date={post.data.pubDate} />}</div>
      </header>
      <div class="reading-layout">
        <aside class="contents"><details open><summary>In this post</summary><nav aria-label="Article sections"><ol>{sections.map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></nav></details></aside>
        <article class="prose">
          {post.data.heroImage && <img class="article-image" src={sitePath(post.data.heroImage)} alt={post.data.heroImageAlt ?? ''} />}
          <Content />
          <div class="article-end"><a class="text-link" href={sitePath()}>← Back to all posts</a><a class="text-link" href="#main-content">Back to top ↑</a></div>
        </article>
      </div>
    </main>
    <Footer />
  </body>
</html>
